rules_version = '2';

// ============================================================
// Manage Bills — Firestore Security Rules
// ============================================================
// Roles:
//   superAdmin  → ravishkapravindika99@gmail.com / ravishkapravinsika99@gmail.com
//   admin       → authenticated + admins/{uid}.status == "approved"
//   guest       → unauthenticated (or authenticated but not approved)
//
// Ownership:
//   Admin can only update their own items (createdBy == uid).
//   Super Admin can update/delete anything.
//   Only Super Admin can delete (soft-delete to recycleBin).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             (request.auth.token.email == 'ravishkapravindika99@gmail.com' ||
              request.auth.token.email == 'ravishkapravinsika99@gmail.com');
    }

    function isApprovedAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'approved';
    }

    function isAdminOrAbove() {
      return isSuperAdmin() || isApprovedAdmin();
    }

    /// True if the caller created this document (createdBy field matches UID).
    function isOwner() {
      return isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ──────────────────────────────────────────
    // /admins/{uid}
    // ──────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isSuperAdmin() ||
                    (isSignedIn() && request.auth.uid == uid);
      allow create: if isSuperAdmin() ||
                     (isSignedIn() && request.auth.uid == uid && request.resource.data.status == 'pending');
      allow update, delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────
    // /companies/{companyId}
    // ──────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAdminOrAbove();
      allow create: if isAdminOrAbove();
      // Admin can only update their own companies; Super Admin can update any
      allow update: if isSuperAdmin() || (isApprovedAdmin() && isOwner());
      // Only Super Admin can delete (soft-delete handled in app)
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────
    // /bills/{billId}
    // ──────────────────────────────────────────
    match /bills/{billId} {
      allow read: if isAdminOrAbove();
      allow create: if isAdminOrAbove();
      allow update: if isSuperAdmin() || (isApprovedAdmin() && isOwner());
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────
    // /products/{productId}
    // ──────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAdminOrAbove();
      allow create: if isAdminOrAbove();
      allow update: if isSuperAdmin() || (isApprovedAdmin() && isOwner());
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────
    // /publicProducts/{productId}
    // ──────────────────────────────────────────
    match /publicProducts/{productId} {
      allow read: if true;  // public — safe fields only in document
      allow write: if isAdminOrAbove();
    }

    // ──────────────────────────────────────────
    // /recycleBin/{itemId}
    // ──────────────────────────────────────────
    // Only Super Admin can read/write the recycle bin.
    match /recycleBin/{itemId} {
      allow read, write: if isSuperAdmin();
    }

    // ──────────────────────────────────────────
    // Catch-all: deny everything else
    // ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
